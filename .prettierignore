# Build output and dependencies
dist/
node_modules/
*.tsbuildinfo
pnpm-lock.yaml

# Generated or third-party content we do not reformat
docs/engineering/evidence/
docs/assets/

# IDBI's own OpenAPI exports, byte for byte as the Atlas portal produced them. Reformatting
# would cost us the one thing they are good for: being exactly what the bank handed over.
docs/idbi-openapi/

# Raw responses captured off IDBI's sandbox. Same reason: evidence, not source.
apps/api/src/adapters/idbi-sandbox/captured/
idbi-capture-*/

# Markdown is written by hand with deliberate line breaks; Prettier leaves prose alone but would
# still rewrap tables and lists in ways that hurt review diffs.
*.md

# Expo writes these on every Metro start (both are in apps/mobile/.gitignore, which Prettier
# does not read when run from the root). Formatting them only lasts until the next start.
apps/mobile/.expo/
apps/mobile/expo-env.d.ts

# The palette is a hand-aligned table (one token per line, values in a column) so a colour change
# reads as one line in review. Prettier would re-flow all of it.
packages/design/tokens.json

# Local Terraform state and provider binaries are gitignored (infra/terraform/.gitignore) but Prettier does not read
# nested .gitignore files when run from the root.
infra/terraform/*.tfstate*
infra/terraform/.terraform/
