# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dhan

# Voice fallback (OpenAI gpt-realtime). Used only when Runway is unavailable.
OPENAI_API_KEY=
LLM_PROVIDER=openai
BANK_SOURCE=fixture
PORT=3001

# Runway Characters — the conversational avatar. Server-side only; the browser is handed
# LiveKit room credentials, never this key.
#   RUNWAY_CHARACTER_ID is the Character (avatar) UUID from https://dev.runwayml.com
RUNWAY_API_KEY=
RUNWAY_CHARACTER_ID=
# Worker uptime ceiling per conversation, in seconds. Billed at 20 credits/minute
# ($0.20/min), so this is a spend control as much as a product one. Schema allows 10-1800.
RUNWAY_MAX_SESSION_SECONDS=600
