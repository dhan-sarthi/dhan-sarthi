# Copy to apps/api/.env and fill in. Never commit the real file.
# apps/api/src/config.ts is the only reader; a blank value means "use the default".

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Where customer data comes from: memory (generator, no database), postgres (seeded rows),
# idbi-sandbox (stub over IDBI's catalogue; holdings and the shelf still come from fixtures).
BANK_SOURCE=memory

# Postgres with the pgvector extension, required when BANK_SOURCE=postgres. The team shares one
# Supabase project; ask a teammate for the password (never commit it). Use the SESSION pooler on
# 5432: the direct host is IPv6-only.
#   Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
#   Local:    postgres://dhan:dhan@localhost:5433/dhan   (docker compose up postgres)
DATABASE_URL=
# The role the API takes on every connection (SET ROLE), so migration 0007's REVOKEs bind the
# server itself: dhan_app cannot UPDATE or DELETE an advice record, a decision, a snapshot or a
# roadmap version, and cannot write seeded identity. The login must be a member of the role with
# SET (migration 0001 grants it). Blank connects as the login. migrate and seed ignore this.
DB_ROLE=dhan_app

# Which avatar provider owns the conversation. `runway`, `anam` and `none` are interchangeable:
# the same routes, the same lease, the same budget and the same tool gate sit behind all three,
# and the client learns which one ran a call only from the grant's `transport`. `none` runs the
# product with the text tier only.
AVATAR_PROVIDER=runway
# Kill switch. false wires the null provider without a deploy of code.
AVATAR_ENABLED=true
# Both values accept a comma-separated list to pool more than one account; entries pair by index.
RUNWAY_API_KEY=
RUNWAY_CHARACTER_ID=
# Per-call cap in seconds (Runway accepts 10–1800). 600 turns one shared Tier-1 slot over across
# reviewers; 1800 is right for one customer and wrong for a shared slot.
RUNWAY_MAX_SESSION_SECONDS=600
# Minutes per day across every credential, metered from the store so a restart cannot reset it.
# 240 minutes ≈ US$48.
RUNWAY_DAILY_MINUTE_BUDGET=240
# Avatar grants per client IP per hour.
AVATAR_SESSIONS_PER_IP_PER_HOUR=5
# Provider-neutral spellings of the two knobs above. Set either; these win when both are set.
AVATAR_MAX_SESSION_SECONDS=
AVATAR_DAILY_MINUTE_BUDGET=

# Anam — the other provider. Same lists-pair-by-index rule as Runway's.
ANAM_API_KEY=
ANAM_AVATAR_ID=
# Account-wide rather than per-credential: one voice and one brain for Uday.
# The ten stock voices are GB, US and FR only; an Indian-English Uday needs a cloned voice.
ANAM_VOICE_ID=
ANAM_LLM_ID=
# The video track's shape. Anam's default is landscape; the app plays the call full-bleed on a
# phone, so portrait is what stops the face being cropped to the eyebrows. 768x1152 is the ONLY
# portrait size Anam accepts — every other ratio is refused at connect time, not at mint time.
ANAM_VIDEO_WIDTH=768
ANAM_VIDEO_HEIGHT=1152
# Where Anam's servers reach THIS api to call the tool gate. Server-to-server, so localhost is
# not reachable and there is nothing to fake: in development this is a tunnel. Without it the
# model would answer from its own head, which is worse than having no gate at all.
ANAM_PUBLIC_BASE_URL=

# Comma-separated allowed origins for the web client. Unset reflects any origin (dev only).
# Production serves / and /api/* from one CloudFront origin and runs with CORS off.
CORS_ORIGIN=
# true behind CloudFront/ALB, so rate limits key on the forwarded client IP.
TRUST_PROXY=false

# Guards /api/v1/operator/*. At least 16 characters. Unset disables those routes.
OPERATOR_KEY=

# Faults to inject by name, comma-separated (see apps/api/src/infra/fault-inject.ts), to walk the
# fallback ladder on demand. Refused when NODE_ENV=production.
FAULT_INJECT=

# The seed: the persona anchor every fixture window is measured from (it never moves) and how
# many months of ledger are written past it — the simulated clock's headroom.
SEED_ANCHOR=2026-09-01
SEED_FORWARD_MONTHS=18
# Months of *use* laid down behind a new session: how long this customer has had the app. The
# engine really runs at each of those months, so Record opens with a decision trail and Plan with
# a version history rather than at zero. Set 0 for a session with no past.
SEED_HISTORY_MONTHS=8

# Stamped into engineVersion and the seed run. Set by the image build; optional locally.
GIT_SHA=

# Where the Account Aggregator sends the customer back to after they approve a consent. It is
# encrypted into IDBI 592's redirection URL, so it has to be a URL this deployment serves and
# the aggregator can reach — localhost cannot work. Unset, the flow still raises a handle and
# records notifications; only the browser-return leg needs it.
#
# The sandbox pins it: 592 validates against its own fixture and answers "redirectUrl does not
# match" for anything but https://myapp.com/consent/callback, which is the default. IDBI has to
# widen that before a real deployment can receive the customer at its own address.
AA_REDIRECT_URL=

# The text tier's language model. It phrases; it never computes. `core/query.ts` produces the
# figures and the suitability rules produce the verdict before a completion is asked for, so an
# absent key costs the wording and nothing else: /ask still answers, still with evidence, and
# `phrasedBy` on the response says `rules` instead of `model`.
OPENAI_API_KEY=
# Any chat model the key can reach. The default is small on purpose — the task is rewriting a
# sentence whose numbers are already fixed and a customer is waiting on it. gpt-5.5 for a demo.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE=https://api.openai.com/v1
# Past the deadline the deterministic answer is sent instead, so a slow model costs a plainer
# sentence rather than a spinner.
OPENAI_TIMEOUT_MS=8000
OPENAI_MAX_OUTPUT_TOKENS=400
OPENAI_TEMPERATURE=0.4
# Kill switch, matching AVATAR_ENABLED: false wires the null model without a deploy of code.
TEXT_MODEL_ENABLED=true
