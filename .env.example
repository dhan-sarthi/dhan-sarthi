# Copy to apps/api/.env and fill in. Never commit the real file.

# Runway Characters — owns the avatar conversation end to end.
# Both values accept a comma-separated list to pool more than one account; entries pair by index.
RUNWAY_API_KEY=
RUNWAY_CHARACTER_ID=
# Per-call cap in seconds (Runway accepts 10–1800) and the daily minute budget per API process.
RUNWAY_MAX_SESSION_SECONDS=1800
RUNWAY_DAILY_MINUTE_BUDGET=240

# Comma-separated allowed origins for the web client. Unset reflects any origin (dev only).
CORS_ORIGIN=

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Postgres with the pgvector extension. The team shares one Supabase project; ask a teammate for
# the password (never commit it). Use the SESSION pooler on 5432: the direct host is IPv6-only.
#   Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
#   Local:    postgres://dhan:dhan@localhost:5433/dhan   (docker compose up postgres)
DATABASE_URL=

# Planned, not read yet: the LLM used for summarisation and embeddings.
# OPENAI_API_KEY=
