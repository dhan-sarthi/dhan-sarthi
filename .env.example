# Copy to apps/api/.env and fill in. Never commit the real file.

# Postgres with the pgvector extension
DATABASE_URL=postgres://dhan:dhan@localhost:5433/dhan

# Runway — owns the avatar conversation end to end
RUNWAY_API_KEY=
RUNWAY_CHARACTER_ID=
RUNWAY_MAX_SESSION_SECONDS=600

# LLM provider for summarisation and embeddings (not the avatar voice)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# fixtures | idbi
BANK_SOURCE=fixtures

PORT=3001
NODE_ENV=development
