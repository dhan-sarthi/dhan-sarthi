{
  "name": "@dhan/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e": "pnpm -r --filter @dhan/core --filter @dhan/contracts --filter @dhan/fixtures build && playwright test"
  },
  "dependencies": {
    "@dhan/contracts": "workspace:*",
    "@dhan/core": "workspace:*",
    "@dhan/fixtures": "workspace:*",
    "@runwayml/avatars": "^0.17.0",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
