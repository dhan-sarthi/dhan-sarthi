{
  "name": "@dhan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:arch": "node --test --experimental-strip-types test/architecture/*.test.ts",
    "migrate": "BANK_SOURCE=postgres node --experimental-strip-types --env-file=.env src/db/migrate.ts",
    "seed": "BANK_SOURCE=postgres node --experimental-strip-types --env-file=.env src/cli/seed.ts",
    "seed:check": "BANK_SOURCE=postgres node --experimental-strip-types --env-file=.env src/cli/seed.ts --check",
    "audit:verify": "BANK_SOURCE=postgres node --experimental-strip-types --env-file=.env src/cli/audit-verify.ts"
  },
  "dependencies": {
    "@dhan/contracts": "workspace:*",
    "@dhan/core": "workspace:*",
    "@dhan/fixtures": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@runwayml/avatars-node-rpc": "^0.1.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2"
  }
}
