{
  "expo": {
    "name": "Dhan Sarthi",
    "slug": "dhan-sarthi",
    "scheme": "dhansarthi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E3329",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.dhansarthi.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Uday listens on a call so you can talk to him instead of typing."
      }
    },
    "android": {
      "package": "in.dhansarthi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3329"
      },
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": ["android.permission.CAMERA", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
