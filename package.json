{
  "name": "dhan-sarthi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @dhan/api dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r --filter './packages/*' build && pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/*' build && pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:icons": "node tools/gen-spend-icons.mjs && node tools/gen-merchant-icons.mjs",
    "assets:art": "node tools/gen-onboarding-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
